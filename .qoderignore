# Specify files or folders to ignore during indexing. Use commas to separate entries. Glob patterns like *.log，my-security/ are supported.

# Dependencies
node_modules/,

# Environment variables and secrets
.env,
.env.local,
.env.production,
config/.env,
*.key,
*.pem,

# Logs
*.log,
npm-debug.log*,
yarn-debug.log*,
yarn-error.log*,
logs/,

# Runtime data
pids/,
*.pid,
*.seed,
*.pid.lock,

# Coverage directory used by tools like istanbul
coverage/,
.nyc_output/,

# Build outputs
dist/,
build/,
out/,

# Cache directories
.cache/,
.npm/,
.yarn/,
node_modules/.cache/,

# OS generated files
.DS_Store,
.DS_Store?,
._*,
.Spotlight-V100,
.Trashes,
ehthumbs.db,
Thumbs.db,

# IDE and editor files
.vscode/,
.idea/,
*.swp,
*.swo,
*~,

# Temporary files
tmp/,
temp/,
*.tmp,
*.temp,

# Database files (if using local SQLite or similar)
*.db,
*.sqlite,
*.sqlite3,

# AI model files and embeddings cache
models/,
embeddings_cache/,
*.bin,
*.onnx,

# Large data files
*.csv,
*.json.gz,
*.zip,
*.tar.gz,

# Documentation build files
docs/_build/,

# Package manager lock files (optional, but can be large)
# package-lock.json,
# yarn.lock