# Database Configuration
MONGO_URI=mongodb://localhost:27017
DB_NAME=memlayer

# API Security
# Optional legacy fallback key (for local testing only). New users should
# register via POST /users/register to receive a unique API key.
# Leave unset in production.
# API_KEY=

# Embeddings Configuration
# Options: LOCAL (default) or OPENAI
EMBEDDINGS_PROVIDER=LOCAL

# OpenAI Configuration (only needed if EMBEDDINGS_PROVIDER=OPENAI)
OPENAI_API_KEY=your-openai-api-key-here

# MCP Server Configuration
MEMORY_API_URL=http://localhost:3000

# Server Configuration
PORT=3000
NODE_ENV=development
