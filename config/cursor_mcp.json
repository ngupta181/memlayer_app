{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false,
      "autoApprove": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "disabled": false,
      "autoApprove": [
        "create_entities",
        "create_relations",
        "add_observations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    },
    "blender": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "blender-mcp"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "YOUR_API_KEY_HERE"
      }
    },
    "memory-storage": {
      "command": "python",
      "args": ["E:\\memlayer_app\\Mem_Python\\mcp_server\\server.py"],
      "env": {
        "MEMORY_API_URL": "http://localhost:8000",
        "API_KEY": "y12s28s06",
        "DEFAULT_USER_ID": "cursor_user"
      }
    },
    "memory-storage-node": {
      "command": "node",
      "args": ["E:\\memlayer_app\\mcp\\server.js"],
      "env": {
        "MEMORY_API_URL": "http://localhost:3000",
        "API_KEY": "changeme",
        "DEFAULT_USER_ID": "cursor_user"
      }
    }
  }
}
